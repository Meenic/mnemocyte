{
	// The whole repository for the editor and `pnpm checktypes`: src, tests
	// and config files. The build settings are in tsconfig.build.json.
	"extends": "./tsconfig.build.json",
	"compilerOptions": {
		"rootDir": ".",
		"noEmit": true,
		"declaration": false,
		"isolatedDeclarations": false,
		"types": ["node"],
		"paths": {
			"mnemocyte": ["./src/index.ts"],
			"mnemocyte/postgres": ["./src/postgres.ts"],
			"mnemocyte/libsql": ["./src/libsql.ts"],
			"mnemocyte/ai-sdk": ["./src/ai-sdk.ts"],
			"mnemocyte/stores/*": ["./src/stores/*.ts"],
			"mnemocyte/embedders": ["./src/embedders/index.ts"],
			"mnemocyte/embedders/*": ["./src/embedders/*.ts"]
		}
	},
	"include": ["src", "test/**/*.ts", "vitest.config.ts", "tsdown.config.ts"],
	"exclude": ["node_modules", "dist", "test/package/exports-types.test-d.ts"]
}
