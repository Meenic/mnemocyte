{
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.15.0",
	"scripts": {
		"build": "pnpm --filter mnemocyte build && pnpm --filter @mnemocyte/mcp build",
		"dev": "pnpm --filter mnemocyte dev",
		"checktypes": "pnpm --filter mnemocyte checktypes && pnpm run checktypes:mcp",
		"test": "pnpm run test:links && pnpm --filter mnemocyte test && pnpm --filter @mnemocyte/mcp test && pnpm run test:examples",
		"test:checks": "pnpm --filter mnemocyte test:checks && pnpm run test:examples",
		"test:ci": "pnpm --filter mnemocyte test:ci",
		"test:unit": "pnpm --filter mnemocyte test:unit",
		"test:contract": "pnpm --filter mnemocyte test:contract",
		"test:types": "pnpm --filter mnemocyte test:types",
		"test:readme": "pnpm --filter mnemocyte test:readme",
		"test:jsdoc": "pnpm --filter mnemocyte test:jsdoc",
		"test:links": "node scripts/check-links.mjs",
		"test:examples": "pnpm --filter @mnemocyte/examples typecheck",
		"test:integration": "pnpm --filter mnemocyte test:integration",
		"test:integration:libsql": "pnpm --filter mnemocyte test:integration:libsql",
		"bench:retrieval": "pnpm --filter mnemocyte bench:retrieval",
		"bench:postgres": "pnpm --filter mnemocyte bench:postgres",
		"bench:libsql": "pnpm --filter mnemocyte bench:libsql",
		"lint": "biome check --error-on-warnings .",
		"lint:fix": "biome check --write .",
		"lint:package": "pnpm --filter mnemocyte lint:package",
		"format": "biome format --write",
		"migration:bundle": "pnpm --filter mnemocyte migration:bundle",
		"pack:check": "pnpm --filter mnemocyte pack:check",
		"build:mcp": "pnpm --filter mnemocyte build && pnpm --filter @mnemocyte/mcp build",
		"checktypes:mcp": "pnpm --filter mnemocyte build && pnpm --filter @mnemocyte/mcp checktypes",
		"test:mcp": "pnpm --filter mnemocyte build && pnpm --filter @mnemocyte/mcp test",
		"lint:package:mcp": "pnpm --filter mnemocyte build && pnpm --filter @mnemocyte/mcp lint:package",
		"pack:check:mcp": "pnpm --filter @mnemocyte/mcp pack:check"
	},
	"engines": {
		"node": ">=22.18"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"github-slugger": "^2.0.0"
	}
}
