{
	// The settings for src/, the same as the two packages that bundle it.
	// Nothing is emitted: tsdown in those packages builds this source.
	// `declaration` is on only so `isolatedDeclarations` checks the exports.
	"compilerOptions": {
		"rootDir": "./src",
		"noEmit": true,

		"module": "nodenext",
		"target": "es2024",
		"lib": ["es2024"],
		"types": ["node"],

		"declaration": true,
		"isolatedDeclarations": true,

		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,

		"strict": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"isolatedModules": true,
		"noUncheckedSideEffectImports": true,
		"moduleDetection": "force",
		"skipLibCheck": true
	},
	"include": ["src"],
	"exclude": ["node_modules"]
}
