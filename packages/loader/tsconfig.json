{
	// The whole package for the editor and `pnpm checktypes`: src, tests and
	// config files. The settings for src/ are in tsconfig.build.json.
	"extends": "./tsconfig.build.json",
	"compilerOptions": {
		"rootDir": ".",
		"noEmit": true,
		"declaration": false,
		"isolatedDeclarations": false,
		"types": ["node"]
	},
	"include": ["src", "test/**/*.ts", "vitest.config.ts"],
	"exclude": ["node_modules"]
}
