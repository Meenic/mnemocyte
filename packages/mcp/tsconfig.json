{
	// The whole package for the editor and `pnpm checktypes`: src, tests,
	// scripts and config files. The build settings are in
	// tsconfig.build.json.
	// `mnemocyte` resolves to its built dist/ through the workspace link, as
	// in an app, so build it first.
	"extends": "./tsconfig.build.json",
	"compilerOptions": {
		"rootDir": ".",
		"noEmit": true,
		"declaration": false,
		"isolatedDeclarations": false,
		"types": ["node"]
	},
	"include": [
		"src",
		"test/**/*.ts",
		"scripts/*.ts",
		"vitest.config.ts",
		"tsdown.config.ts"
	],
	"exclude": ["node_modules", "dist", "test/fixtures/**"]
}
